# SautiSmart Backend Server Environment Variables Example
# Duplicate this file as .env and update with your actual configuration.

# Port for Express API Server
PORT=5000

# Environment Mode (development / production / test)
NODE_ENV=development

# JSON Web Token Secret Key
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection String
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/sautismart

# MongoDB Atlas (Cloud):
MONGODB_URI=mongodb+srv://daisykhaemba7_db_user:<PASSWORD>@cluster0.jinziev.mongodb.net/SautiSmartdb?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://daisykhaemba7_db_user:<PASSWORD>@cluster0.jinziev.mongodb.net/SautiSmartdb?retryWrites=true&w=majority
